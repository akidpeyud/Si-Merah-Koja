# Larang akses dan eksekusi file script berbahaya
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|cgi|pl|exe|sh|bash|py)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Nonaktifkan engine interpreter PHP jika Apache mod_php aktif
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Larang eksekusi skrip CGI
Options -ExecCGI
